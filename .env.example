# Read by docker compose from a root .env (copy this file to .env).
# The API has its own apps/api/.env.example; apps/web/.env.example lists the
# web app's optional settings.

# Host port of the development database (127.0.0.1 only). 5442 by default,
# not PostgreSQL's 5432, so it does not collide with a PostgreSQL installed on
# the machine. Change it when 5442 is taken too, and update DATABASE_URL in
# apps/api/.env to match.
# DB_PORT=5442

# Host ports of the development mail catcher, Mailpit (127.0.0.1 only): SMTP
# and its web UI. 1035 and 8035 by default, not Mailpit's 1025 and 8025, so
# it does not share ports with another project's Mailpit. Change them when
# taken, and MAIL_SMTP_URL in apps/api/.env to match.
# MAILPIT_SMTP_PORT=1035
# MAILPIT_UI_PORT=8035

# Production-like stack only (docker compose --profile stack up --build):
# the API refuses to boot without it. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
# WEB_PORT=8080
# The build the stack's images report on logs and error reports, baked in at
# build time (default: local): letters, digits, ".", "_", "+", "-", such as a
# commit SHA.
# APP_RELEASE=local

# Host port and password of the development Redis (127.0.0.1 only), started
# with the database by `pnpm services:up`. 6389 by default, not Redis's 6379,
# so it does not collide with a Redis installed on the machine; the password
# "app" when unset, like the database's (local development only). Change
# either, and REDIS_URL in apps/api/.env to match.
# REDIS_PORT=6389
# REDIS_PASSWORD=app

# --- Optional services -------------------------------------------------------

# Local OpenTelemetry backend (docker compose --profile observability up -d).
# OTLP_HTTP_PORT=4318
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090

# The production-like stack: it runs on the Redis above (shared rate limits
# and cache). Another Redis, or the in-process stores:
# STACK_REDIS_URL=redis://:<password>@<host>:6379
# STACK_RATE_LIMIT_STORE=memory
# STACK_CACHE_STORE=memory
# Optional integrations (all off by default):
# STACK_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318   (with --profile observability)
# STACK_SENTRY_DSN=
# STACK_WEB_SENTRY_DSN=
