{
  "name": "project-template",
  "version": "1.2.0",
  "private": true,
  "description": "Full-stack TypeScript project template: NestJS API and React SPA with quality, security and delivery gates wired in from day 0.",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm services:up && node scripts/dev.mjs",
    "services:up": "docker compose up --detach --wait db mailpit",
    "build": "pnpm --recursive build",
    "lint": "pnpm --filter api exec prisma generate && eslint . --max-warnings=0",
    "lint:fix": "pnpm --filter api exec prisma generate && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --recursive test",
    "test:coverage": "pnpm --recursive test:coverage",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "security": "pnpm audit --audit-level=high && pnpm deps:check && pnpm secrets:scan",
    "deps:check": "node scripts/check-dependencies.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "sast": "node scripts/sast.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "observability:check": "node scripts/check-observability.mjs",
    "iac:check": "node scripts/check-iac.mjs",
    "iac:database": "node scripts/iac-database.mjs",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --sbom-type application --prod --out dist/sbom/sbom.cdx.json",
    "perf:check": "node scripts/check-bundle-size.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "contract": "pnpm --filter api openapi:export && pnpm --filter web api:types",
    "db:up": "docker compose up --detach --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm security && pnpm build && pnpm perf:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  }
}
