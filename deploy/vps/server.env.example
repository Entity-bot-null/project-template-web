# This server's settings for compose.yaml (copy to server.env). Not secret.
# The public host name: its DNS A record points at this server (no AAAA:
# IPv6 is off, docs/deploy-vps.md section 2).
APP_DOMAIN=app.example.com
# The database on this server: PostgreSQL and its nightly backup
# (docs/deploy-vps.md#5-the-database; then db.env and backup.env). Remove this
# line to use a managed PostgreSQL instead (the Terraform path does).
COMPOSE_PROFILES=db
# With the database here: days of nightly backups kept on the server, and the
# time they are taken (UTC).
# BACKUP_KEEP_DAYS=7
# BACKUP_AT=03:00
