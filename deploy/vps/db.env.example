# The database container's configuration, when this server runs it
# (COMPOSE_PROFILES=db in server.env): copy to db.env, chmod 600. Secrets:
# never commit the filled-in file. Each one: openssl rand -hex 24.
#
# Read once, the first time the database's volume is empty: db-init.sh then
# creates the database app and these roles (docs/deploy-vps.md#5-the-database).
# Changing a value afterwards changes nothing in PostgreSQL by itself
# (docs/deploy-vps.md#change-a-setting-or-a-secret).
#
# The superuser's: no application uses that role.
POSTGRES_PASSWORD=
# The migrator's (owns the schema): the same in migrate.env's DATABASE_URL.
APP_MIGRATOR_PASSWORD=
# The API's (reads and writes data): the same in api.env's DATABASE_URL.
APP_RUNTIME_PASSWORD=
# The nightly backup's (reads only): the same in backup.env.
APP_BACKUP_PASSWORD=
