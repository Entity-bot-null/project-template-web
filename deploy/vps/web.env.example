# The web image's configuration (copy to web.env). Public values only: they
# are served to every browser as /app/app-config.json. APP_ORIGIN comes from
# APP_DOMAIN in server.env (compose.yaml).
APP_ENVIRONMENT=production
# WEB_SENTRY_DSN=
# Share of page loads that report their Web Vitals, 0 to 1 (0: off).
# WEB_VITALS_SAMPLE_RATE=1
