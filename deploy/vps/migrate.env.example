# The migration job's configuration (copy to migrate.env, chmod 600).
# The migrator role: owns the schema, used only while migrating.
# Placeholders, not credentials: filled in on the server only.
#
# The database on this server (COMPOSE_PROFILES=db): the service db, on the
# server's internal network, with APP_MIGRATOR_PASSWORD of db.env.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string
DATABASE_URL=postgresql://app_migrator:<APP_MIGRATOR_PASSWORD>@db:5432/app
#
# Or a managed database, over TLS. On DigitalOcean or Amazon RDS, end the URL
# with ?sslmode=require&uselibpqcompat=true
# (docs/deploy-vps.md#6-the-files-on-the-server); the Terraform outputs do.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string
# DATABASE_URL=postgresql://app_migrator:<password>@<database host>:5432/app?sslmode=require
