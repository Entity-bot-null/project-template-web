# The API container's configuration (copy to api.env, chmod 600). Secrets:
# never commit the filled-in file. Every variable: docs/environment.md.

# The runtime role: data access only, no schema changes. Placeholders, not
# credentials: filled in on the server only.
#
# The database on this server (COMPOSE_PROFILES=db): the service db, on the
# server's internal network, with APP_RUNTIME_PASSWORD of db.env.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string
DATABASE_URL=postgresql://app_runtime:<APP_RUNTIME_PASSWORD>@db:5432/app
#
# Or a managed database, over TLS. On DigitalOcean or Amazon RDS, end the URL
# with ?sslmode=require&uselibpqcompat=true
# (docs/deploy-vps.md#6-the-files-on-the-server); the Terraform outputs do.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string
# DATABASE_URL=postgresql://app_runtime:<password>@<database host>:5432/app?sslmode=require

# openssl rand -hex 32 (one per environment).
JWT_ACCESS_SECRET=
# staging or production: tags every log line and error report.
APP_ENVIRONMENT=production
# The public origin of the app (https:// + APP_DOMAIN): browsers that send no
# Fetch Metadata (older Safari) are refused by the CSRF guard without it, and
# links in emails point to it.
APP_ORIGIN=https://app.example.com

# Email, optional (docs/manual.md#115-email): your provider's SMTP server,
# encrypted (smtps://, or smtp:// with STARTTLS), the password percent-encoded.
# Unset: email is off. Then: authenticate the sending domain (SPF, DKIM, DMARC).
# MAIL_SMTP_URL=smtps://<user>:<password>@<provider host>:465
# MAIL_FROM="<Product> <no-reply@app.example.com>"
# Public sign-up, optional (docs/security.md#sign-up): anyone can create an
# account by confirming their address. Requires email. Default: false.
# SIGN_UP_ENABLED=true

# Redis on this server (service redis): the user app, REDIS_PASSWORD of
# redis.env. Rate limits and cache shared by every API instance, locks and
# idempotency, and a readiness that fails without it. Plain redis:// on the
# server's internal network (the API says so once at boot).
REDIS_URL=redis://app:<REDIS_PASSWORD>@redis:6379
RATE_LIMIT_STORE=redis
CACHE_STORE=redis
REDIS_REQUIRED=true

# Optional (docs/environment.md):
# SENTRY_DSN=
# DB_POOL_MAX=10
# LOG_LEVEL=log
