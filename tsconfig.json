{
  // Root-level TypeScript and the JavaScript tooling scripts (type-checked
  // through JSDoc). Each app has its own tsconfig.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts", "scripts/**/*.mjs", "apps/*/scripts/**/*.mjs"]
}
