    {
      "type": "row",
      "id": 14,
      "title": "Page loads",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Good page loads by metric",
      "description": "Share of the page loads rated \"good\" over the previous hour (thresholds of web.dev). The Core Web Vitals pass when LCP, INP and CLS are all good for at least 75 % of the page loads.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (web_vital_name) (increase(app_web_vitals_duration_seconds_count{job=\"$job\", deployment_environment_name=~\"$environment\", page_route=~\"$route\", web_vital_rating=\"good\"}[1h])) / sum by (web_vital_name) (increase(app_web_vitals_duration_seconds_count{job=\"$job\", deployment_environment_name=~\"$environment\", page_route=~\"$route\"}[1h]))",
          "legendFormat": "{{web_vital_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(app_web_vitals_cls_count{job=\"$job\", deployment_environment_name=~\"$environment\", page_route=~\"$route\", web_vital_rating=\"good\"}[1h])) / sum(increase(app_web_vitals_cls_count{job=\"$job\", deployment_environment_name=~\"$environment\", page_route=~\"$route\"}[1h]))",
          "legendFormat": "CLS",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "Page loads reported, by page and navigation",
      "description": "Page loads that reported their Web Vitals, per minute (each reports one TTFB), by route pattern and navigation type: navigate, reload, back-forward, back-forward-cache (restored from the cache), prerender. Bounded by WEB_VITALS_SAMPLE_RATE.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "60 * sum by (page_route, web_vital_navigation_type) (rate(app_web_vitals_duration_seconds_count{job=\"$job\", deployment_environment_name=~\"$environment\", page_route=~\"$route\", web_vital_name=\"TTFB\"}[$__rate_interval]))",
          "legendFormat": "{{page_route}} {{web_vital_navigation_type}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 17,
      "title": "Web Vitals alerts firing or pending",
      "description": "The alerts of observability/prometheus/rules/web-vitals-alerts.yaml: p75 of LCP, INP or CLS above \"good\" on a page for 30 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (alertname, alertstate, page_route) (ALERTS{alertname=~\"WebVitals.*\", job=\"$job\", deployment_environment_name=~\"$environment\"})",
          "legendFormat": "{{alertname}} {{page_route}} {{alertstate}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
