{
  "name": "api",
  "version": "2.1.0",
  "private": true,
  "description": "HTTP API: NestJS, Prisma (PostgreSQL), Zod validation, OpenAPI contract.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && nest start --watch --path tsconfig.dev.json",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest",
    "test:coverage": "prisma generate && vitest run --coverage",
    "test:integration": "prisma generate && vitest run --config vitest.config.int.ts",
    "openapi:export": "prisma generate && nest build && node dist/openapi/export.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && nest build && node dist/seed/run.js",
    "user:create": "prisma generate && nest build && node dist/users/create-user.cli.js",
    "mail": "prisma generate && nest build && node dist/infrastructure/mail/mail.cli.js",
    "e2e:server": "node scripts/e2e-server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@redis/client": "^6.3.0",
    "@sentry/core": "^11.9.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "import-in-the-middle": "^3.5.2",
    "nodemailer": "^10.2.1",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "pg": "^8.23.1",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
