---
// The close, in the page's colours turned over: the opening idea again, the
// sentence that says how to get in, and the action on its baseline.
import { messages, type Locale } from '../i18n';
import { appPath } from '../lib/links';
import Headline from './Headline.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);
---

<section
  aria-labelledby="call-to-action-heading"
  class="flex flex-col justify-between gap-16 bg-ink px-(--margin) pt-[clamp(5rem,12vh,8rem)] pb-10 text-ground md:gap-24 md:pb-12 lg:min-h-[90svh]"
>
  <Headline as="h2" id="call-to-action-heading" lines={t.callToAction.heading} motion="scroll" />
  <div class="flex flex-col gap-8 md:flex-row md:items-baseline-last md:justify-between">
    <p class="reveal max-w-[36ch] text-lead">{t.callToAction.body}</p>
    <a href={appPath('sign-in')} class="button reveal w-full md:w-auto [--i:1]">
      {t.callToAction.action}
    </a>
  </div>
</section>
