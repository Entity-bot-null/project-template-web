---
// A picture of the page that accepts an invitation
// (apps/web/src/pages/AcceptInvitationPage.tsx), filled in.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div data-ui role="img" aria-label={label} class="ui w-full max-w-[35rem] p-5 sm:p-6">
  <p class="text-[1.25rem] font-semibold">Accept your invitation</p>
  <p class="mt-2">Choose your name and a password to create your account.</p>
  <div class="mt-5 flex flex-col gap-4">
    <div>
      <span class="block font-medium">Name</span>
      <span class="ui-field mt-1">Ada Lovelace</span>
    </div>
    <div>
      <span class="block font-medium">Password</span>
      <span class="ui-field mt-1 tracking-[0.2em]">•••••••••••••••••••</span>
      <span class="mt-1 block text-panel-muted">
        At least 15 characters. A few words you can remember work well.
      </span>
    </div>
  </div>
  <span class="ui-button mt-5">Create my account</span>
</div>
