---
// What is included, at poster size: the heading is the list's first line, in
// the muted ink; each capability's name runs across two thirds of the page,
// its sentence on the same baseline in the last third.
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);
// The rows arrive in threes, each a little after the one above. Written out
// in full so Tailwind finds the classes in this file.
const STAGGER = ['[--i:0]', '[--i:1]', '[--i:2]'] as const;
---

<section
  id="capabilities"
  aria-labelledby="capabilities-heading"
  class="px-(--margin) py-[clamp(7.5rem,20vh,15rem)]"
>
  <h2 id="capabilities-heading" class="reveal text-head font-bold text-muted">
    {t.capabilities.heading}
  </h2>
  <ul class="capabilities mt-[0.35em] flex flex-col gap-7 md:gap-[0.35em] md:text-head" role="list">
    {t.capabilities.items.map(({ name, description }, index) => (
      <li
        class:list={[
          'capability reveal md:grid md:grid-cols-12 md:items-baseline md:gap-x-(--gutter)',
          STAGGER[index % STAGGER.length],
        ]}
      >
        <h3 class="capability-name pl-[0.6em] -indent-[0.6em] text-head font-bold md:col-span-7 md:pl-0 md:indent-0 lg:col-span-8">
          {name}
        </h3>
        <p class="mt-2 max-w-[60ch] pl-(--margin) text-body md:col-span-5 md:mt-0 md:pl-0 lg:col-span-4">
          {description}
        </p>
      </li>
    ))}
  </ul>
</section>
