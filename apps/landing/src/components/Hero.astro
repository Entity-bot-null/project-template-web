---
// The first screen, type and colour only: the statement across the width,
// the sentence that says what this is at the bottom left, and the one action
// on its baseline at the right. A full screen tall on wide screens; on
// narrower ones as tall as its content, so no stretch of it stands empty.
import { messages, type Locale } from '../i18n';
import { appPath } from '../lib/links';
import Headline from './Headline.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);
---

<section
  aria-labelledby="hero-heading"
  class="flex flex-col justify-between gap-16 px-(--margin) pt-36 pb-10 md:gap-24 md:pt-40 md:pb-12 lg:min-h-svh"
>
  <Headline as="h1" id="hero-heading" lines={t.home.heading} class="max-w-[15ch]" />
  <div class="flex flex-col gap-8 md:flex-row md:items-baseline-last md:justify-between">
    <p class="reveal-load max-w-[36ch] text-lead [--d:420ms]">{t.home.lead}</p>
    <a href={appPath()} class="button reveal-load w-full md:w-auto [--d:520ms]">
      {t.home.action}
    </a>
  </div>
</section>
