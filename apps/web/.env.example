# The web app needs no variables: it calls the API on its own origin (/api).
#
# Anything named VITE_* is embedded in the JavaScript bundle and readable by
# every visitor. Never put a secret, a token or a private URL in one.
#
# Development only: where `pnpm dev` and `vite preview` forward /api.
# API_PROXY_TARGET=http://127.0.0.1:3000
#
# Optional runtime settings, served to the app as /app-config.json (public,
# like the bundle). The dev and preview servers read them from their own
# environment; the production image from the container's
# (docs/environment.md#web-variables).
# APP_ENVIRONMENT=development
# APP_RELEASE=unversioned
# Error tracking: the DSN of a Sentry browser project. Empty: off.
# WEB_SENTRY_DSN=https://<public key>@<host>/<project id>
# WEB_SENTRY_SAMPLE_RATE=1
